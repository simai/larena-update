APP_NAME="Larena Update"
APP_ENV=local
APP_DEBUG=true

# Release keys this site trusts besides those the distribution ships in config/larena-release-keys.php:
# key id => base64 of a 32-byte Ed25519 public key, comma-separated. Public keys only. Malformed pairs are ignored.
# LARENA_UPDATE_TRUSTED_KEYS=stand-release=<base64 of the public key>
